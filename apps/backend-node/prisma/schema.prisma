generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  nombre       String
  rol          String    @default("directivo")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Seccion {
  id                  Int        @id @default(autoincrement())
  nombre              String     @unique
  bloques             BloqueHorario[]
  cursos              Curso[]
  reunionSecciones    ReunionSeccion[] @relation("ReunionSeccionSeccion")
  deportes            DeporteSeccion[]
  profesoresAdscritos Profesor[]
}

model DiaSemana {
  id                Int    @id @default(autoincrement())
  numeroDia         Int    @unique
  esHorarioEspecial Boolean @default(false)
  bloques           BloqueHorario[]
  reunionSecciones  ReunionSeccion[]
  deportes          DeporteSeccion[]
  colaborativas     ColaborativaGenerada[]
}

model BloqueHorario {
  id           Int     @id @default(autoincrement())
  seccion      Seccion @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  seccionId    Int
  diaSemana    DiaSemana @relation(fields: [diaSemanaId], references: [id], onDelete: Cascade)
  diaSemanaId  Int
  numeroPeriodo String
  horaInicio   String
  horaFin      String
  esAcademico  Boolean @default(true)
  asignaciones HorarioAsignado[]

  @@unique([seccionId, diaSemanaId, numeroPeriodo])
}

model Profesor {
  id                        Int      @id @default(autoincrement())
  nombre                    String
  seccionBase               Seccion  @relation(fields: [seccionBaseId], references: [id], onDelete: Restrict)
  seccionBaseId             Int
  departamento              Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  departamentoId            Int?
  prefiereGruposConsecutivos Boolean @default(false)
  esTiempoCompleto          Boolean  @default(true)
  jornadaParcial            Json?
  cargas                    CargaAcademica[]
}

model Curso {
  id        Int    @id @default(autoincrement())
  seccion   Seccion @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  seccionId Int
  nombre    String
  cargas    CargaAcademica[]

  @@unique([seccionId, nombre])
}

model Materia {
  id             Int                   @id @default(autoincrement())
  nombre         String                @unique
  departamento   Departamento?         @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  departamentoId Int?
  cargas         CargaAcademica[]
  mismoBloqueA   MateriaMismoBloque[]  @relation("MateriaMismoBloqueA")
  mismoBloqueB   MateriaMismoBloque[]  @relation("MateriaMismoBloqueB")
}

model MateriaMismoBloque {
  id         Int    @id @default(autoincrement())
  materiaAId Int
  materiaA   Materia @relation("MateriaMismoBloqueA", fields: [materiaAId], references: [id], onDelete: Cascade)
  materiaBId Int
  materiaB   Materia @relation("MateriaMismoBloqueB", fields: [materiaBId], references: [id], onDelete: Cascade)

  @@unique([materiaAId, materiaBId])
}

model Departamento {
  id             Int                   @id @default(autoincrement())
  nombre         String                @unique
  reunionActiva  Boolean               @default(false)
  materias       Materia[]
  colaborativas  ColaborativaGenerada[]
  profesores     Profesor[]
}

model Configuracion {
  clave String @id
  valor String
}

model ReunionSeccion {
  id          Int           @id @default(autoincrement())
  diaSemanaId Int
  diaSemana   DiaSemana     @relation(fields: [diaSemanaId], references: [id], onDelete: Cascade)
  horaInicio  String
  horaFin     String
  secciones   Seccion[]     @relation("ReunionSeccionSeccion")
}

model DeporteSeccion {
  id            Int         @id @default(autoincrement())
  seccionId     Int
  seccion       Seccion     @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  diaSemanaId   Int
  diaSemana     DiaSemana   @relation(fields: [diaSemanaId], references: [id], onDelete: Cascade)
  numeroPeriodo String

  @@unique([seccionId, diaSemanaId, numeroPeriodo])
}

model ColaborativaGenerada {
  id             Int           @id @default(autoincrement())
  departamentoId Int
  departamento   Departamento  @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  diaSemanaId    Int
  diaSemana      DiaSemana     @relation(fields: [diaSemanaId], references: [id], onDelete: Cascade)
  horaInicio     String
  horaFin        String
}

model CargaAcademica {
  id                         Int     @id @default(autoincrement())
  curso                      Curso   @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  cursoId                    Int
  materia                    Materia @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  materiaId                  Int
  profesor                   Profesor @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  profesorId                 Int
  bloquesSemanalesRequeridos Int
  asignaciones               HorarioAsignado[]

  @@unique([cursoId, materiaId, profesorId])
}

model HorarioAsignado {
  id               Int            @id @default(autoincrement())
  cargaAcademica   CargaAcademica @relation(fields: [cargaAcademicaId], references: [id], onDelete: Cascade)
  cargaAcademicaId Int
  bloqueHorario    BloqueHorario  @relation(fields: [bloqueHorarioId], references: [id], onDelete: Cascade)
  bloqueHorarioId  Int

  @@unique([cargaAcademicaId, bloqueHorarioId])
}